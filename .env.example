# ==========================================
# MikroTik ISP Billing & Management Platform
# Environment Configuration Template
# ==========================================

NODE_ENV=development

# ------------------------------------------
# Database & Cache Configuration
# ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mikrotik_billing?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mikrotik_billing_test?schema=public
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Ports & Host Configuration
# ------------------------------------------
PORT=4000
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------
# Security & Encryption Secrets (Placeholders)
# ------------------------------------------
# 32-byte hex string (64 characters) used for AES-256-GCM credential encryption at rest
APP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_change_in_production
SESSION_SECRET=super_secret_session_key_for_development_purposes_only

# ------------------------------------------
# Mock Modes & Lab Device Flags
# ------------------------------------------
# When true, uses MockRouterAdapter rather than real RouterOS socket/REST calls
ROUTER_MOCK_MODE=true

# When true, queues SMS without attempting real external telecom gateway calls
SMS_MOCK_MODE=true

# When true, accepts payment initiation and mocks webhook callback confirmation
PAYMENT_MOCK_MODE=true

# ------------------------------------------
# Real Gateway Config Placeholders (Disabled by default)
# ------------------------------------------
SMS_GATEWAY_API_KEY=placeholder_sms_api_key
SMS_GATEWAY_SENDER_ID=placeholder_sender_id
PAYMENT_GATEWAY_MERCHANT_ID=placeholder_merchant_id
PAYMENT_GATEWAY_SECRET=placeholder_merchant_secret
