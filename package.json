{
  "name": "mikrotik-billing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant MikroTik ISP billing and network management platform",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "pnpm -r exec rimraf dist .turbo .next coverage",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:reset": "tsx scripts/reset-dev-db.ts"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "playwright": "^1.64.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
